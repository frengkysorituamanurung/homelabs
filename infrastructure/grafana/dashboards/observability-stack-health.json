      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "count(up{cluster=\"homelabs\"} == 1) / count(up{cluster=\"homelabs\"}) * 100",
          "editorMode": "code"
