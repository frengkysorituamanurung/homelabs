            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(kube_pod_status_phase{cluster=\"homelabs\", namespace=~\"$namespace\", pod=~\"$workload\", phase=\"Running\"})",
          "editorMode": "code"
