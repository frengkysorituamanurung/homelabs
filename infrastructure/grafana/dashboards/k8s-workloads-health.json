{
  "uid": "k8s-workloads-health",
  "title": "2. Kubernetes Cluster & Workloads",
  "tags": [
    "observability",
    "kubernetes",
    "sre"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "1. Home Server Overview",
      "url": "/d/homelab-home-dashboard",
      "type": "link",
      "icon": "apps",
      "keepTime": true
    },
    {
      "title": "2. Kubernetes Cluster",
      "url": "/d/k8s-workloads-health",
      "type": "link",
      "icon": "cloud",
      "keepTime": true
    },
    {
      "title": "3. Node & Infrastructure",
      "url": "/d/physical-server-monitoring",
      "type": "link",
      "icon": "monitor",
      "keepTime": true
    },
    {
      "title": "4. Application Monitoring",
      "url": "/d/app-http-golden-signals",
      "type": "link",
      "icon": "bolt",
      "keepTime": true
    },
    {
      "title": "5. Logs & Troubleshooting",
      "url": "/d/loki-logs-explorer",
      "type": "link",
      "icon": "file-alt",
      "keepTime": true
    },
    {
      "title": "6. Distributed Tracing",
      "url": "/d/distributed-tracing-tempo",
      "type": "link",
      "icon": "sitemap",
      "keepTime": true
    },
    {
      "title": "7. Observability Stack Health",
      "url": "/d/observability-stack-health",
      "type": "link",
      "icon": "heart",
      "keepTime": true
    },
    {
      "title": "Grafana Explore",
      "url": "/explore",
      "type": "link",
      "icon": "compass",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "query": {
          "query": "label_values(kube_pod_info{cluster=\"homelabs\"}, namespace)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "workload",
        "label": "Pod / Workload Filter",
        "type": "textbox",
        "query": ".*",
        "current": {
          "selected": false,
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Kubernetes Workload Status",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Ready Nodes",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(kube_node_status_condition{cluster=\"homelabs\", condition=\"Ready\", status=\"true\"})",
          "editorMode": "code"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
