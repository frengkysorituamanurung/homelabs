      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(container_memory_working_set_bytes{cluster=\"homelabs\", namespace=~\"$namespace\", pod!=\"\"}) by (namespace)",
          "legendFormat": "Actual: {{namespace}}",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(kube_pod_container_resource_requests{cluster=\"homelabs\", resource=\"memory\", namespace=~\"$namespace\"}) by (namespace)",
