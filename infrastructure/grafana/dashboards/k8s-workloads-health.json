    {
      "id": 16,
      "type": "logs",
      "title": "Live Kubernetes Cluster Events Stream (Loki source=\"k8s-events\")",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "x": 10,
        "y": 22,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{cluster=\"homelabs\", source=\"k8s-events\", namespace=~\"$namespace\"}",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
