    {
      "id": 9,
      "type": "row",
      "title": "Resource Consumption vs Requests & Limits (By Namespace / Top Pods)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
