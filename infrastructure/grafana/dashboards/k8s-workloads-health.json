          "expr": "sum(kube_deployment_status_replicas_available{cluster=\"homelabs\", namespace=~\"$namespace\"}) / sum(kube_deployment_spec_replicas{cluster=\"homelabs\", namespace=~\"$namespace\"}) * 100",
