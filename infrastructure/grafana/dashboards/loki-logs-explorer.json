            "uid": "Loki"
          },
          "expr": "sum(rate({cluster=\"homelabs\", namespace=~\"$namespace\", pod=~\"$pod\"} |~ \"(?i)(error|exception|fatal|panic)\" [5m])) * 60",
          "editorMode": "code"
