  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Traefik Backend Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "query": {
          "query": "label_values(traefik_service_requests_total{cluster=\"homelabs\", job=\"prometheus.scrape.traefik\"}, service)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "namespace",
        "label": "App Namespace (Logs)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "VictoriaMetrics"
        },
        "query": {
          "query": "label_values(kube_pod_info{cluster=\"homelabs\", namespace=~\"backend|production|staging|development|frontend|immich|harbor|n8n|umami|uptime-kuma\"}, namespace)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "allValue": "backend|production|staging|development|frontend|immich|harbor|n8n|umami|uptime-kuma",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
