      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "100 - (avg(rate(node_cpu_seconds_total{cluster=\"homelabs\", job=\"prometheus.scrape.node_exporter\", mode=\"idle\"}[5m])) * 100)",
          "editorMode": "code"
