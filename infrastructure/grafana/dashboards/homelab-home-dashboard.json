    {
      "id": 17,
      "type": "timeseries",
      "title": "CPU & RAM Utilization Trend (%)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 10,
