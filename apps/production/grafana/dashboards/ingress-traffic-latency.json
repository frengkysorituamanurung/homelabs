      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(traefik_entrypoint_requests_total{code=~\"2..\"}[1m]))",
