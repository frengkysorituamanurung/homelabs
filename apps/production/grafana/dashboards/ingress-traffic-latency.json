          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(traefik_entrypoint_requests_total{code=~\"3..\"}[1m]))",
          "legendFormat": "HTTP 3xx (Redirect)",
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(traefik_entrypoint_requests_total{code=~\"4..\"}[1m]))",
          "legendFormat": "HTTP 4xx (Client Error)",
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(traefik_entrypoint_requests_total{code=~\"5..\"}[1m]))",
          "legendFormat": "HTTP 5xx (Server Error)",
          "refId": "D"
        }
      ],
      "title": "HTTP Response Status Code Rates",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15
