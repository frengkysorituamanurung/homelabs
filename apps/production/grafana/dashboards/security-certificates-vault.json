        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "(min(traefik_tls_certs_not_after) - time()) / 86400",
          "legendFormat": "Days Until Expiration",
          "refId": "A"
        }
      ],
      "title": "Next TLS Certificate Expiration (Days)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
